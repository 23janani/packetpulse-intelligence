# ==============================================================================
# PacketPulse Intelligence Environment Configuration
# ==============================================================================

# RIPE Atlas API Configuration
# Optional: RIPE Atlas allows public read access to public ongoing measurements without an API key.
# If you have an active RIPE Atlas API Key, you may configure it below for higher rate limits:
RIPE_ATLAS_API_KEY=
RIPE_ATLAS_BASE_URL=https://atlas.ripe.net/api/v2

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./backend/data/packetpulse.db

# Refresh and Network Timing
DEFAULT_REFRESH_SECONDS=60
REQUEST_TIMEOUT_SECONDS=12.0
CACHE_TTL_SECONDS=45

# Server Port Configuration
PORT=8000
HOST=127.0.0.1
